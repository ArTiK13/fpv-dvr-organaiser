# Workstation only: reuse an already trusted runtime image with ffmpeg/CA installed.
# Useful for cross-compiled updates without executing ARM64 programs on x86.
# Pass an explicit base tag/digest with --build-arg RUNTIME_IMAGE=...
ARG RUNTIME_IMAGE=fpv-catalog-runtime:bookworm-arm64
FROM ${RUNTIME_IMAGE}
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
COPY --chmod=0555 fpv-catalog-bot /usr/local/bin/fpv-catalog-bot
