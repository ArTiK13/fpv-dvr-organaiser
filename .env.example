# Host path; docker-compose mounts it at /srv/fpv/sorted inside the app.
VIDEO_ROOT=/srv/fpv/sorted
APP_UID=10001
APP_GID=10001
APP_PORT=8080
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://fpv:change-me@postgres:5432/fpv

# Include /api for the API URL; public URL points to the web interface.
# Reach existing Immich via its LAN DNS/address (not localhost in the container).
IMMICH_BASE_URL=http://immich.example.lan:2283/api
IMMICH_PUBLIC_URL=https://photos.example.com
IMMICH_API_KEY=replace-me
IMMICH_LIBRARY_ID=11111111-1111-4111-8111-111111111111
IMMICH_CONTAINER_ROOT=/mnt/fpv
IMMICH_ASSET_WAIT_TIMEOUT=30m
IMMICH_LINK_TTL=7d
IMMICH_SHARE_CHUNK_SIZE=500
# Set separately in Immich: external library cron */15 * * * *

TELEGRAM_BOT_TOKEN=replace-me
BOOTSTRAP_ADMIN_CHAT_ID=123456789
# Internal catalog user ID, not Telegram ID. /defaultuser overrides this.
DEFAULT_USER_ID=
TELEGRAM_MAX_BYTES=49000000
SCAN_INTERVAL=60s
REQUIRE_SYNC_RECEIPTS=true
STABLE_SECONDS=60
DELIVERY_ENABLED=true
NOTIFICATIONS_ENABLED=true
BIND_ADDR=0.0.0.0:8080
# Optional HTTPS endpoint, reverse proxy to the app; only admins can issue tokens.
FALLBACK_BASE_URL=
RUST_LOG=info
